# Set USE_MOCK_DB=true untuk pengujian lokal tanpa database MySQL
USE_MOCK_DB=false

# Konfigurasi Database (MySQL / TiDB Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=buku_kontak

# Set DB_SSL=true jika database mewajibkan koneksi TLS (otomatis true jika DB_HOST non-localhost)
DB_SSL=false

PORT=3000
